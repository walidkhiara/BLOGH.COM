{%- comment -%}
  Renders price for a product or variant.
  - product: product (required)
  - variant: optional, overrides product price
  - size: 'lg' for PDP
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare = target.compare_at_price
  assign varies = false
  if variant == blank and product.price_varies
    assign varies = true
    assign price = product.price_min
    assign compare = product.compare_at_price_min
  endif
  assign on_sale = false
  if compare > price
    assign on_sale = true
  endif
-%}
<div class="price{% if size == 'lg' %} price--lg{% endif %}" data-price>
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
    <span class="price__sale">{% if varies %}{{ 'products.product.from' | t: price: '' }}{% endif %}{{ price | money }}</span>
    <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
    <s class="price__compare">{{ compare | money }}</s>
  {%- else -%}
    <span class="price__regular">{% if varies %}{{ 'products.product.from' | t: price: '' }}{% endif %}{{ price | money }}</span>
  {%- endif -%}
</div>
