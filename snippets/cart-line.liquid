{%- comment -%} One cart line. - item: line_item, - index: forloop.index (line number) {%- endcomment -%}
<div class="cart-item" data-cart-line="{{ index }}" data-key="{{ item.key }}">
  <a href="{{ item.url }}" class="media media--ratio" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{ item.image | image_url: width: 240 | image_tag: widths: '120, 240', sizes: '120px', loading: 'lazy', alt: item.image.alt | default: item.product.title }}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>
  <div class="cart-item__body">
    <div class="cart-item__top">
      <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
      <div class="price">
        {%- if item.original_line_price > item.final_line_price -%}
          <span class="price__sale">{{ item.final_line_price | money }}</span>
          <s class="price__compare">{{ item.original_line_price | money }}</s>
        {%- else -%}
          <span class="price__regular">{{ item.final_line_price | money }}</span>
        {%- endif -%}
      </div>
    </div>
    {%- unless item.product.has_only_default_variant -%}
      <p class="cart-item__opts">
        {%- for option in item.options_with_values -%}{{ option.value | escape }}{% unless forloop.last %} / {% endunless %}{%- endfor -%}
      </p>
    {%- endunless -%}
    {%- for property in item.properties -%}
      {%- assign first_char = property.first | slice: 0 -%}
      {%- if property.last != blank and first_char != '_' -%}
        <p class="cart-item__opts">{{ property.first }}: {{ property.last }}</p>
      {%- endif -%}
    {%- endfor -%}
    {%- for discount in item.line_level_discount_allocations -%}
      <p class="cart-item__opts">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>
    {%- endfor -%}
    <div class="cart-item__actions">
      <div class="qty qty--sm">
        <button type="button" data-qty-change="-1" aria-label="{{ 'products.product.decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
        <input type="number" min="0" value="{{ item.quantity }}" data-line-qty aria-label="{{ 'products.product.quantity' | t }}: {{ item.product.title | escape }}">
        <button type="button" data-qty-change="1" aria-label="{{ 'products.product.increase' | t }}">{% render 'icon', name: 'plus' %}</button>
      </div>
      <button type="button" class="cart-item__remove" data-line-remove aria-label="{{ 'cart.remove' | t: title: item.product.title | escape }}">{{ 'cart.remove_label' | t }}</button>
    </div>
  </div>
</div>
