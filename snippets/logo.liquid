{%- comment -%}
  IZAVEN lockup. Uses the logo uploaded in Theme settings → Brand when set,
  otherwise the bundled lockup asset.
  - tone: 'dark' (default, for light backgrounds) | 'light' (for dark backgrounds)
  - class, width
{%- endcomment -%}
{%- liquid
  assign asset = 'izaven-logo-black.png'
  if tone == 'light'
    assign asset = 'izaven-logo-white.png'
  endif
-%}
{%- if settings.logo != blank and tone != 'light' -%}
  {{ settings.logo | image_url: width: 600 | image_tag: alt: shop.name, class: class, widths: '200, 400, 600', loading: 'eager' }}
{%- else -%}
  <img src="{{ asset | asset_url }}" alt="{{ shop.name | escape }}" class="{{ class }}" width="1005" height="229" loading="eager">
{%- endif -%}
