{%- if settings.free_shipping_threshold != blank and cart.item_count > 0 -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign pct = cart.total_price | times: 1.0 | divided_by: threshold
    if pct > 1
      assign pct = 1
    endif
  -%}
  <div class="ship-bar">
    <span>
      {%- if remaining > 0 -%}{%- assign remaining_money = remaining | money -%}{{ 'cart.free_shipping_remaining' | t: amount: remaining_money }}{%- else -%}{{ 'cart.free_shipping_reached' | t }}{%- endif -%}
    </span>
    <div class="ship-bar__track"><span style="transform: scaleX({{ pct }})"></span></div>
  </div>
{%- endif -%}
