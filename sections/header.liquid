{%- liquid
  assign menu = section.settings.menu
-%}
<div class="header-wrapper" data-header data-sticky="{{ section.settings.sticky }}">
  <header class="header" data-header-inner>
    <div class="header-scrim" aria-hidden="true"></div>
    <div class="page-width header__inner">
      <div class="header__left">
        <button type="button" class="icon-btn header__menu-toggle" data-open-drawer="menu" aria-controls="MenuDrawer" aria-expanded="false" aria-label="{{ 'general.menu' | t }}">
          {% render 'icon', name: 'menu' %}
        </button>
        <nav class="nav" aria-label="Primary">
          <ul class="nav__list" role="list">
            {%- for link in menu.links -%}
              {%- liquid
                assign feature = nil
                for block in section.blocks
                  assign block_handle = block.settings.menu_item | handle
                  if block_handle == link.handle
                    assign feature = block
                  endif
                endfor
              -%}
              <li class="nav__item" {% if link.links.size > 0 %}data-mega{% endif %}>
                <a href="{{ link.url }}" class="nav__link" {% if link.current %}aria-current="page"{% endif %}
                  {% if link.links.size > 0 %}aria-expanded="false" aria-haspopup="true" aria-controls="Mega-{{ forloop.index }}"{% endif %}>
                  {{- link.title | escape -}}
                </a>
                {%- if link.links.size > 0 -%}
                  <div class="mega" id="Mega-{{ forloop.index }}">
                    <div class="page-width mega__inner">
                      {%- for child in link.links limit: 4 -%}
                        <div>
                          <a href="{{ child.url }}" class="eyebrow mega__col-title">{{ child.title | escape }}</a>
                          {%- if child.links.size > 0 -%}
                            <ul class="mega__links" role="list">
                              {%- for grandchild in child.links -%}
                                <li><a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                      {%- if feature -%}
                        <a href="{{ feature.settings.link | default: link.url }}" class="mega__feature" {{ feature.shopify_attributes }}>
                          <div class="media media--ratio">
                            {%- if feature.settings.image -%}
                              {{ feature.settings.image | image_url: width: 900 | image_tag: widths: '450, 700, 900', sizes: '30vw', loading: 'lazy', alt: feature.settings.heading | escape }}
                            {%- else -%}
                              <div class="media__fallback"><span>{{ feature.settings.heading | escape }}</span></div>
                            {%- endif -%}
                          </div>
                          <span class="mega__feature-label h-md">{{ feature.settings.heading | escape }}</span>
                        </a>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      </div>

      <a href="{{ routes.root_url }}" class="header__logo" style="--logo-w: {{ settings.logo_width }}px">
        {% render 'logo' %}
      </a>

      <div class="header__icons">
        <button type="button" class="icon-btn" data-open-search aria-controls="SearchModal" aria-label="{{ 'accessibility.search' | t }}">{% render 'icon', name: 'search' %}</button>
        {%- if shop.customer_accounts_enabled -%}
          <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="icon-btn" aria-label="{{ 'accessibility.account' | t }}">{% render 'icon', name: 'account' %}</a>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" class="icon-btn" {% if settings.cart_type == 'drawer' %}data-open-drawer="cart" aria-controls="CartDrawer" role="button"{% endif %}
          aria-label="{{ 'accessibility.cart' | t }}, {{ 'accessibility.cart_count' | t: count: cart.item_count }}" data-cart-link>
          {% render 'icon', name: 'bag' %}
          <span class="cart-count" data-cart-count aria-hidden="true">{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}</span>
        </a>
      </div>
    </div>
  </header>
</div>

<div class="overlay" data-overlay="menu" data-close-drawer></div>
<div class="drawer drawer--left" id="MenuDrawer" role="dialog" aria-modal="true" aria-label="{{ 'general.menu' | t }}" data-drawer="menu" tabindex="-1">
  <div class="drawer__head">
    {% render 'logo', class: 'drawer-logo' %}
    <button type="button" class="icon-btn" data-close-drawer aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
  </div>
  <div class="drawer__body">
    <ul class="mobile-nav" role="list">
      {%- for link in menu.links -%}
        <li class="mobile-nav__item">
          {%- if link.links.size > 0 -%}
            <details>
              <summary>{{ link.title | escape }} {% render 'icon', name: 'plus' %}</summary>
              <div class="mobile-nav__sub">
                <a href="{{ link.url }}" class="link-underline" style="justify-self:start">{{ 'general.view_all' | t }} {{ link.title | escape }}</a>
                {%- for child in link.links -%}
                  <div>
                    <a href="{{ child.url }}" class="eyebrow mega__col-title">{{ child.title | escape }}</a>
                    {%- if child.links.size > 0 -%}
                      <ul class="mega__links" role="list">
                        {%- for grandchild in child.links -%}<li><a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li>{%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            </details>
          {%- else -%}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    <div class="mobile-nav__utility">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}">{% if customer %}{{ 'customer.account' | t }}{% else %}{{ 'customer.login' | t }}{% endif %}</a>
      {%- endif -%}
      {%- for link in section.settings.utility_menu.links -%}
        <a href="{{ link.url }}">{{ link.title | escape }}</a>
      {%- endfor -%}
    </div>
  </div>
</div>
<style>.drawer-logo { width: 110px; height: auto; }</style>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu", "info": "Three levels: top items, column titles, column links." },
    { "type": "link_list", "id": "utility_menu", "label": "Mobile utility links", "info": "E.g. Help, Delivery, Returns." },
    { "type": "checkbox", "id": "sticky", "label": "Hide on scroll down, show on scroll up", "default": true }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Mega menu image",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Top menu item", "info": "Exact title of the top-level item, e.g. Women." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "New season" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
