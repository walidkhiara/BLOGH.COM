{%- assign s = section.settings -%}
{%- assign form_id = 'Newsletter-' | append: section.id -%}
<section class="newsletter" style="{% if s.style == 'dark' %}--nl-bg: #0b0b0c; --nl-fg: #fff;{% endif %}">
  <div class="page-width newsletter__inner">
    <div style="display:grid;gap:16px">
      {%- if s.eyebrow != blank -%}<p class="eyebrow"><span class="slash" aria-hidden="true"></span>{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="h-xl" data-reveal>{{ s.heading | escape }}</h2>
    </div>
    <div style="display:grid;gap:16px">
      {%- if s.text != blank -%}<div class="lede" style="opacity:.8">{{ s.text }}</div>{%- endif -%}
      {%- form 'customer', id: form_id -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="field-row">
          <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
          <input type="email" name="contact[email]" id="NewsletterEmail-{{ section.id }}" placeholder="{{ 'newsletter.email' | t }}" autocomplete="email" required
            {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterMsg-{{ section.id }}"{% endif %}>
          <button type="submit">{{ 'newsletter.submit' | t }} {% render 'icon', name: 'arrow' %}</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="form-msg" id="NewsletterMsg-{{ section.id }}" role="status">{{ 'newsletter.success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="form-msg form-msg--error" id="NewsletterMsg-{{ section.id }}" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>
<style>.newsletter .icon { width: 16px; height: 16px; }</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Members first" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Early access. Every drop." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "style", "label": "Style", "default": "light", "options": [ { "value": "light", "label": "Light grey" }, { "value": "dark", "label": "Black" } ] }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
