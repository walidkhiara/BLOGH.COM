{%- liquid
  assign s = section.settings
  assign current_variant = product.selected_or_first_available_variant
  assign color_names = settings.color_option_names | downcase | split: ','
  assign form_id = 'ProductForm-' | append: section.id
-%}
<div class="product" data-product data-section-id="{{ section.id }}" data-url="{{ product.url }}">
  <div class="gallery{% if s.feature_first %} gallery--feature{% endif %}" data-gallery>
    <ul class="gallery__track" role="list" data-gallery-track aria-label="{{ product.title | escape }}">
      {%- for media in product.media -%}
        <li class="gallery__item" data-media-id="{{ media.id }}">
          <div class="media media--ratio">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- assign loading = 'lazy' -%}
                {%- if forloop.index <= 2 -%}{%- assign loading = 'eager' -%}{%- endif -%}
                {{ media | image_url: width: 1800 | image_tag:
                    widths: '500, 750, 1000, 1300, 1800',
                    sizes: '(min-width: 990px) 32vw, 100vw',
                    loading: loading,
                    alt: media.alt | default: product.title }}
              {%- when 'video' -%}
                {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1200x' }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag }}
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        </li>
      {%- else -%}
        <li class="gallery__item"><div class="media media--ratio">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div></li>
      {%- endfor -%}
    </ul>
    {%- if product.media.size > 1 -%}
      <div class="gallery__dots" aria-hidden="true">
        {%- for media in product.media -%}<span {% if forloop.first %}class="is-active"{% endif %}></span>{%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-info">
    <div class="product-info__sticky">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <div class="product-info__head" {{ block.shopify_attributes }}>
              {%- if product.tags contains settings.new_badge_tag -%}<span class="badge badge--accent" style="justify-self:start">{{ 'products.product.new' | t }}</span>{%- endif -%}
              <h1 class="product-info__title h-lg">{{ product.title | escape }}</h1>
              <p class="product-info__sub" data-variant-subtitle>
                {%- for option in product.options_with_values -%}
                  {%- assign n = option.name | downcase -%}
                  {%- if color_names contains n -%}{{ option.selected_value | escape }}{%- endif -%}
                {%- endfor -%}
                {%- if product.type != blank %} · {{ product.type | escape }}{% endif -%}
              </p>
              <div data-price-wrap>{% render 'price', product: product, variant: current_variant, size: 'lg' %}</div>
              {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}<p class="muted" style="font-size:12px">{{ 'products.product.tax_included' | t }}</p>{%- endif -%}
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variant-picker" data-variant-picker {{ block.shopify_attributes }} style="display:grid;gap:20px">
                {%- for option in product.options_with_values -%}
                  {%- liquid
                    assign n = option.name | downcase
                    assign is_color = false
                    if color_names contains n
                      assign is_color = true
                    endif
                    assign opt_index = forloop.index0
                  -%}
                  <fieldset class="option" data-option-index="{{ opt_index }}">
                    <legend class="option__legend">
                      <span><strong>{{ option.name | escape }}</strong><span class="option__legend-value" data-option-value>{{ option.selected_value | escape }}</span></span>
                      {%- if is_color == false and block.settings.size_guide_page != blank and forloop.last -%}
                        <button type="button" class="text-btn" data-open-modal="SizeGuide-{{ section.id }}">{{ 'products.product.size_guide' | t }}</button>
                      {%- endif -%}
                    </legend>
                    <div class="option__values{% unless is_color %} option__values--sizes{% endunless %}">
                      {%- for value in option.values -%}
                        {%- assign input_id = section.id | append: '-' | append: opt_index | append: '-' | append: forloop.index0 -%}
                        {%- if is_color -%}
                          {%- liquid
                            assign swatch_img = nil
                            for v in product.variants
                              if v.options[opt_index] == value and v.featured_image
                                assign swatch_img = v.featured_image
                                break
                              endif
                            endfor
                          -%}
                          <label class="option-swatch" title="{{ value | escape }}">
                            <input type="radio" name="option-{{ opt_index }}" id="{{ input_id }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                            <span class="option-swatch__img" style="{% if swatch_img %}--swatch: url({{ swatch_img | image_url: width: 140 }}){% else %}{% render 'swatch-style', value: value %}{% endif %}"></span>
                            <span class="visually-hidden">{{ value | escape }}</span>
                          </label>
                        {%- else -%}
                          <label class="option-btn">
                            <input type="radio" name="option-{{ opt_index }}" id="{{ input_id }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                            <span class="option-btn__label">{{ value | escape }}</span>
                          </label>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
                <script type="application/json" data-variants>{{ product.variants | json }}</script>
              </div>

              {%- if block.settings.size_guide_page != blank -%}
                <div class="modal" id="SizeGuide-{{ section.id }}" role="dialog" aria-modal="true" aria-labelledby="SizeGuideTitle-{{ section.id }}" data-modal>
                  <div class="modal__backdrop" data-close-modal></div>
                  <div class="modal__panel" tabindex="-1">
                    <button type="button" class="icon-btn modal__close" data-close-modal aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
                    <h2 class="h-lg" id="SizeGuideTitle-{{ section.id }}" style="margin-bottom:24px">{{ block.settings.size_guide_page.title | escape }}</h2>
                    <div class="rte size-guide">{{ block.settings.size_guide_page.content }}</div>
                  </div>
                </div>
              {%- endif -%}
            {%- endunless -%}

          {%- when 'buy_buttons' -%}
            {%- form 'product', product, id: form_id, class: 'buy', novalidate: 'novalidate', data-product-form: '' -%}
              <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
              <div class="stock{% if current_variant.available == false %} stock--out{% elsif current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity <= block.settings.low_stock and current_variant.inventory_policy == 'deny' %} stock--low{% endif %}" data-stock aria-live="polite" {{ block.shopify_attributes }}>
                {%- if current_variant.available == false -%}
                  {{ 'products.product.sold_out' | t }}
                {%- elsif current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity <= block.settings.low_stock and current_variant.inventory_policy == 'deny' -%}
                  {{ 'products.product.low_stock' | t: count: current_variant.inventory_quantity }}
                {%- else -%}
                  {{ 'products.product.in_stock' | t }}
                {%- endif -%}
              </div>
              <div class="buy__row">
                {%- if block.settings.show_quantity -%}
                  <div class="qty" data-qty>
                    <button type="button" data-qty-step="-1" aria-label="{{ 'products.product.decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                    <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}">
                    <button type="button" data-qty-step="1" aria-label="{{ 'products.product.increase' | t }}">{% render 'icon', name: 'plus' %}</button>
                  </div>
                {%- endif -%}
                <button type="submit" name="add" class="btn btn--tall" data-add-button {% unless current_variant.available %}disabled{% endunless %}>
                  <span data-add-label>{%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
                </button>
              </div>
              <p class="product-error" data-product-error role="alert" hidden></p>
              {%- if block.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
            {%- endform -%}

          {%- when 'usp' -%}
            <ul class="usp" role="list" {{ block.shopify_attributes }}>
              {%- if block.settings.line_1 != blank -%}<li>{% render 'icon', name: 'truck' %}<span>{{ block.settings.line_1 | escape }}</span></li>{%- endif -%}
              {%- if block.settings.line_2 != blank -%}<li>{% render 'icon', name: 'return' %}<span>{{ block.settings.line_2 | escape }}</span></li>{%- endif -%}
              {%- if block.settings.line_3 != blank -%}<li>{% render 'icon', name: 'ruler' %}<span>{{ block.settings.line_3 | escape }}</span></li>{%- endif -%}
            </ul>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary>{{ 'products.product.description' | t }} {% render 'icon', name: 'plus' %}</summary>
                <div class="accordion__body rte">{{ product.description }}</div>
              </details>
            {%- endif -%}

          {%- when 'accordion' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading | escape }} {% render 'icon', name: 'plus' %}</summary>
              <div class="accordion__body rte">
                {{ block.settings.content }}
                {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
              </div>
            </details>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_image -%}"image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
    "description": {{ product.description | strip_html | strip | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
          "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Product information",
  "settings": [
    { "type": "checkbox", "id": "feature_first", "label": "Make first image full width on desktop", "default": false }
  ],
  "blocks": [
    { "type": "title", "name": "Title & price", "limit": 1 },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1,
      "settings": [ { "type": "page", "id": "size_guide_page", "label": "Size guide page", "info": "Shown in a pop-up next to the size option." } ] },
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": true },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": false },
        { "type": "range", "id": "low_stock", "label": "Low stock warning at", "min": 1, "max": 20, "step": 1, "default": 5 }
      ] },
    { "type": "usp", "name": "Delivery highlights", "limit": 1,
      "settings": [
        { "type": "text", "id": "line_1", "label": "Line 1", "default": "Free standard delivery over €75" },
        { "type": "text", "id": "line_2", "label": "Line 2", "default": "Free 30-day returns" },
        { "type": "text", "id": "line_3", "label": "Line 3", "default": "Fits true to size" }
      ] },
    { "type": "description", "name": "Description", "limit": 1,
      "settings": [ { "type": "checkbox", "id": "open", "label": "Open by default", "default": true } ] },
    { "type": "accordion", "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Delivery & returns" },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "page", "id": "page", "label": "Or show page content" }
      ] }
  ]
}
{% endschema %}
