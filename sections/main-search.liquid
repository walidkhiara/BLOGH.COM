{%- liquid
  assign s = section.settings
  assign sort_by = search.sort_by | default: search.default_sort_by
-%}
<div class="page-width title-block">
  <h1 class="h-xl">{% if search.performed %}{{ search.terms | escape }}{% else %}{{ 'search.title' | t }}{% endif %}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
    <label for="SearchPageInput" class="visually-hidden">{{ 'search.title' | t }}</label>
    <input class="input" type="search" id="SearchPageInput" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'header.search_placeholder' | t }}">
    <input type="hidden" name="options[prefix]" value="last">
    <button class="btn" type="submit">{{ 'search.submit' | t }}</button>
  </form>
</div>

{%- if search.performed -%}
<div data-results-section data-section-id="{{ section.id }}">
  {%- paginate search.results by s.per_page -%}
    <div class="toolbar" data-toolbar>
      <div class="page-width toolbar__inner">
        <p class="toolbar__count" role="status">{{ 'search.results_for' | t: count: search.results_count, terms: search.terms }}</p>
        <div class="toolbar__controls">
          {%- if search.filters.size > 0 -%}
            <button type="button" class="toolbar__btn" data-open-drawer="facets" aria-controls="FacetsDrawer" aria-expanded="false">{% render 'icon', name: 'filter' %} {{ 'collections.filter_and_sort' | t }}</button>
          {%- endif -%}
        </div>
      </div>
    </div>
    <div class="page-width results" data-results>
      {% render 'active-filters', results: search %}
      {%- if search.results_count > 0 -%}
        <ul class="product-grid" role="list" data-product-grid style="margin-top:16px">
          {%- for item in search.results -%}
            <li>
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- else -%}
                <a href="{{ item.url }}" class="article-card">
                  <div class="media media--ratio">
                    {%- if item.image -%}{{ item.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '25vw', widths: '400, 800' }}{%- else -%}<div class="media__fallback"><span>{{ item.title | escape }}</span></div>{%- endif -%}
                  </div>
                  <span class="eyebrow muted">{{ item.object_type }}</span>
                  <span class="card__title">{{ item.title | escape }}</span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="empty"><p class="lede">{{ 'search.no_results' | t: terms: search.terms }}</p></div>
      {%- endif -%}
    </div>
    {%- if search.filters.size > 0 -%}
      {% render 'facets', results: search, sort_by: sort_by, sort_options: search.sort_options, url: routes.search_url %}
    {%- endif -%}
  {%- endpaginate -%}
</div>
{%- endif -%}

{% schema %}
{
  "name": "Search results",
  "settings": [ { "type": "range", "id": "per_page", "label": "Results per page", "min": 12, "max": 48, "step": 4, "default": 24 } ]
}
{% endschema %}
