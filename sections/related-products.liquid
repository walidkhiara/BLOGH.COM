{%- assign s = section.settings -%}
<section class="section" style="--section-pt: {{ section.settings.padding_top | default: 0 }}px; --section-pb: {{ section.settings.padding_bottom | default: 0 }}px; --cols-desktop: 4;" data-related
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.limit }}&intent=related">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="section-head">
        <h2 class="h-lg">{{ s.heading | escape }}</h2>
        <div class="carousel__nav">
          <button type="button" class="carousel__btn" data-carousel-prev aria-controls="Carousel-{{ section.id }}" aria-label="{{ 'accessibility.slide_prev' | t }}" disabled>{% render 'icon', name: 'arrow-left' %}</button>
          <button type="button" class="carousel__btn" data-carousel-next aria-controls="Carousel-{{ section.id }}" aria-label="{{ 'accessibility.slide_next' | t }}">{% render 'icon', name: 'arrow' %}</button>
        </div>
      </div>
      <div class="carousel" data-carousel>
        <ul class="carousel__track" id="Carousel-{{ section.id }}" role="list" data-carousel-track tabindex="0" aria-label="{{ s.heading | escape }}">
          {%- for product in recommendations.products -%}<li>{% render 'product-card', product: product %}</li>{%- endfor -%}
        </ul>
        <div class="carousel__progress" aria-hidden="true"><span data-carousel-progress></span></div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the fit" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 10, "step": 1, "default": 8 },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 96 }
  ]
}
{% endschema %}
