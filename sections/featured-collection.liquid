{%- liquid
  assign s = section.settings
  assign collection = s.collection | default: collections.all
  assign products = collection.products
-%}
<section class="section" style="--section-pt: {{ section.settings.padding_top | default: 0 }}px; --section-pb: {{ section.settings.padding_bottom | default: 0 }}px; --cols-desktop: {{ s.columns }};">
  <div class="page-width">
    <div class="section-head{% if s.align == 'center' %} section-head--center{% endif %}" data-reveal>
      <div>
        {%- if s.eyebrow != blank -%}<p class="eyebrow muted" style="margin-bottom:10px">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="h-lg">{{ s.heading | default: collection.title | escape }}</h2>
      </div>
      <div class="section-head__actions">
        {%- if s.show_view_all and collection != blank -%}
          <a href="{{ collection.url }}" class="link-underline">{{ 'general.view_all' | t }}</a>
        {%- endif -%}
        {%- if s.layout == 'carousel' -%}
          <div class="carousel__nav">
            <button type="button" class="carousel__btn" data-carousel-prev aria-controls="Carousel-{{ section.id }}" aria-label="{{ 'accessibility.slide_prev' | t }}" disabled>{% render 'icon', name: 'arrow-left' %}</button>
            <button type="button" class="carousel__btn" data-carousel-next aria-controls="Carousel-{{ section.id }}" aria-label="{{ 'accessibility.slide_next' | t }}">{% render 'icon', name: 'arrow' %}</button>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if collection != blank and products.size > 0 -%}
      {%- if s.layout == 'carousel' -%}
        <div class="carousel" data-carousel>
          <ul class="carousel__track" id="Carousel-{{ section.id }}" role="list" data-carousel-track tabindex="0" aria-label="{{ s.heading | default: collection.title | escape }}">
            {%- for product in products limit: s.limit -%}
              <li>{% render 'product-card', product: product %}</li>
            {%- endfor -%}
          </ul>
          <div class="carousel__progress" aria-hidden="true"><span data-carousel-progress></span></div>
        </div>
      {%- else -%}
        <ul class="product-grid" role="list">
          {%- for product in products limit: s.limit -%}
            <li>{% render 'product-card', product: product %}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- else -%}
      <p class="muted">Choose a collection with products in the theme editor.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the collection title." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products shown", "min": 2, "max": 24, "step": 1, "default": 12 },
    { "type": "select", "id": "layout", "label": "Layout", "default": "carousel", "options": [ { "value": "carousel", "label": "Carousel" }, { "value": "grid", "label": "Grid" } ] },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "align", "label": "Heading alignment", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
