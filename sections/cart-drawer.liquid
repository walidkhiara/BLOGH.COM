<div class="overlay" data-overlay="cart" data-close-drawer></div>
<aside class="drawer drawer--right" id="CartDrawer" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" data-drawer="cart" tabindex="-1">
  <div class="drawer__head">
    <h2 class="h-md" id="CartDrawerTitle">{{ 'cart.title' | t }} <span class="muted" data-cart-count-text>({{ cart.item_count }})</span></h2>
    <button type="button" class="icon-btn" data-close-drawer aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
  </div>
  <div class="drawer__inner" data-cart-drawer-inner data-section-id="{{ section.id }}" style="display:flex;flex-direction:column;flex:1;min-height:0">
    {%- if cart.item_count > 0 -%}
      {% render 'ship-bar' %}
      <div class="drawer__body">
        <div class="cart-items" data-cart-items>
          {%- for item in cart.items -%}
            {% render 'cart-line', item: item, index: forloop.index %}
          {%- endfor -%}
        </div>
      </div>
      <div class="drawer__foot cart-totals">
        {%- for discount in cart.cart_level_discount_applications -%}
          <div class="cart-totals__row"><span>{{ discount.title | escape }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
        {%- endfor -%}
        <div class="cart-totals__row"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money_with_currency }}</span></div>
        <small>{{ 'cart.taxes' | t }}</small>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="btn btn--block btn--tall">{{ 'cart.checkout' | t }} {% render 'icon', name: 'arrow' %}</button>
        </form>
        <a href="{{ routes.cart_url }}" class="btn btn--outline btn--block">{{ 'cart.view_cart' | t }}</a>
        <p class="product-error" data-cart-error role="alert" hidden></p>
      </div>
    {%- else -%}
      <div class="cart-empty">
        <p class="h-lg">{{ 'cart.empty' | t }}</p>
        <a href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}" class="btn">{{ 'cart.empty_cta' | t }} {% render 'icon', name: 'arrow' %}</a>
      </div>
    {%- endif -%}
  </div>
</aside>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    { "type": "url", "id": "empty_link", "label": "Empty bag button link" }
  ]
}
{% endschema %}
