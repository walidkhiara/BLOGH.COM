{%- liquid
  assign s = section.settings
  assign cols = section.blocks.size | at_most: 4 | at_least: 1
-%}
<section class="section{% if s.edge %} tiles--edge{% endif %}" style="--section-pt: {{ section.settings.padding_top | default: 0 }}px; --section-pb: {{ section.settings.padding_bottom | default: 0 }}px;">
  {%- if s.heading != blank -%}
    <div class="page-width section-head" data-reveal>
      <h2 class="h-lg">{{ s.heading | escape }}</h2>
    </div>
  {%- endif -%}
  <div class="{% unless s.edge %}page-width{% endunless %}">
    <div class="tiles" style="--cols: {{ cols }}; --tile-ar: {% case s.ratio %}{% when 'tall' %}3 / 4{% when 'square' %}1 / 1{% when 'wide' %}4 / 3{% else %}4 / 5{% endcase %}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign img = block.settings.image | default: c.featured_image
          assign title = block.settings.title | default: c.title
          assign url = block.settings.link | default: c.url | default: routes.all_products_collection_url
        -%}
        <a href="{{ url }}" class="tile" data-reveal style="--reveal-i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="media">
            {%- if img -%}
              {{ img | image_url: width: 1600 | image_tag: widths: '500, 800, 1100, 1600', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: img.alt | default: title }}
            {%- else -%}
              <div class="media__fallback"><span>{{ title | escape }}</span></div>
            {%- endif -%}
          </div>
          <div class="tile__scrim" aria-hidden="true"></div>
          <div class="tile__body">
            {%- if block.settings.eyebrow != blank -%}<span class="eyebrow">{{ block.settings.eyebrow | escape }}</span>{%- endif -%}
            <h3 class="h-xl">{{ title | escape }}</h3>
            <span class="tile__cta">{{ block.settings.cta | default: 'Shop now' | escape }} {% render 'icon', name: 'arrow' %}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>.tile .icon { width: 14px; height: 14px; } .tile .icon { transition: transform var(--motion-standard) var(--ease-standard); } .tile:hover .icon { transform: translateX(4px); }</style>

{% schema %}
{
  "name": "Collection tiles",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "edge", "label": "Edge to edge", "default": true },
    { "type": "select", "id": "ratio", "label": "Tile shape", "default": "portrait",
      "options": [ { "value": "portrait", "label": "Portrait 4:5" }, { "value": "tall", "label": "Tall 3:4" }, { "value": "square", "label": "Square" }, { "value": "wide", "label": "Landscape 4:3" } ] },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 4 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image." },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the collection title." },
        { "type": "text", "id": "cta", "label": "Link label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Custom link", "info": "Overrides the collection link." }
      ]
    }
  ],
  "presets": [ { "name": "Collection tiles", "blocks": [ { "type": "tile" }, { "type": "tile" } ] } ]
}
{% endschema %}
