{%- assign s = section.settings -%}
<section class="section" style="--section-pt: 0px; --section-pb: 0px;">
  <div class="page-width title-block">
    <h1 class="h-xl">{{ s.heading | default: page.title | escape }}</h1>
    {%- if s.intro != blank -%}<div class="lede muted" style="margin-top:16px">{{ s.intro }}</div>{%- endif -%}
  </div>

  <div class="page-width contact">
    <aside class="contact__info" aria-label="Contact details">
      <div>
        <p class="eyebrow muted">Email</p>
        <p><a class="link-underline" href="mailto:{{ shop.email }}">{{ shop.email }}</a></p>
      </div>
      {%- if s.show_address and shop.address.address1 != blank -%}
        <div>
          <p class="eyebrow muted">Address</p>
          <p>
            {{ shop.name | escape }}<br>
            {{ shop.address.address1 | escape }}<br>
            {{ shop.address.zip | escape }} {{ shop.address.city | escape }}<br>
            {{ shop.address.country | escape }}
          </p>
        </div>
      {%- endif -%}
      {%- if s.hours != blank -%}
        <div>
          <p class="eyebrow muted">{{ s.hours_label | default: 'Hours' | escape }}</p>
          <p>{{ s.hours | escape }}</p>
        </div>
      {%- endif -%}
      <div>
        <p class="eyebrow muted">Orders &amp; returns</p>
        <ul role="list" class="contact__links">
          {%- for link in s.help_menu.links -%}
            <li><a class="link-underline" href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
          {%- if s.help_menu == blank -%}
            <li><a class="link-underline" href="{{ routes.root_url }}pages/track-your-order">Track your order</a></li>
            <li><a class="link-underline" href="{{ routes.root_url }}policies/shipping-policy">Shipping &amp; delivery</a></li>
            <li><a class="link-underline" href="{{ routes.root_url }}policies/refund-policy">Returns &amp; refunds</a></li>
          {%- endif -%}
        </ul>
      </div>
    </aside>

    <div class="contact__form">
      {%- form 'contact', id: 'ContactForm', class: 'form', novalidate: 'novalidate' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-msg" role="status" tabindex="-1" autofocus>Thanks — your message has been sent. We'll reply by email.</p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="form-msg form-msg--error" role="alert" tabindex="-1" autofocus>
            <p>Please fix the following:</p>
            <ul>
              {%- for field in form.errors -%}
                <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        <label>Name
          <input class="input" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
        </label>
        <label>Email
          <input class="input" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}" {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}>
        </label>
        <label>Order number <span class="muted" style="font-weight:400">(optional)</span>
          <input class="input" type="text" name="contact[order_number]" autocomplete="off" placeholder="#1001" value="{{ form.order_number }}">
        </label>
        <label>How can we help?
          <textarea class="input" style="height:auto;padding:12px" rows="6" name="contact[body]" required {% if form.errors contains 'body' %}aria-invalid="true"{% endif %}>{{ form.body }}</textarea>
        </label>
        <button class="btn btn--tall" type="submit">Send message {% render 'icon', name: 'arrow' %}</button>
      {%- endform -%}
    </div>
  </div>
</section>
<style>
  .contact { display: grid; gap: var(--space-7); padding-bottom: var(--space-9); }
  .contact__info { display: grid; gap: var(--space-5); align-content: start; font-size: 15px; }
  .contact__links { display: grid; gap: 10px; justify-items: start; }
  .contact__form textarea.input { resize: vertical; min-height: 140px; }
  @media (min-width: 990px) { .contact { grid-template-columns: minmax(260px, 1fr) minmax(0, 1.6fr); gap: var(--space-9); } }
</style>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Questions about an order, sizing or a return? Send us a message.</p>" },
    { "type": "checkbox", "id": "show_address", "label": "Show business address", "default": true, "info": "Taken from Settings → General." },
    { "type": "text", "id": "hours_label", "label": "Hours label", "default": "Hours" },
    { "type": "text", "id": "hours", "label": "Support hours", "info": "Optional, e.g. Mon–Fri 9:00–17:00 CET. Only add what you can keep." },
    { "type": "link_list", "id": "help_menu", "label": "Help links", "info": "Defaults to Track your order, Shipping and Returns." }
  ],
  "presets": [ { "name": "Contact" } ]
}
{% endschema %}
