{% comment %} Category tiles, Apple-scale: big type, generous gaps, large tiles. {% endcomment %}
<section class="fcc-wrap lc-fade-up">
  {% if section.settings.heading != blank %}
    <h2 class="fcc-heading">{{ section.settings.heading }}</h2>
  {% endif %}
  <div class="fcc-grid">
    {% for block in section.blocks %}
      {% assign coll = collections[block.settings.collection] %}
      <a href="{{ coll.url | default: '#' }}" class="fcc-tile">
        {% if block.settings.image %}
          {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'fcc-img' }}
        {% elsif coll.image %}
          {{ coll.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'fcc-img' }}
        {% endif %}
        <div class="fcc-label">{{ block.settings.label | default: coll.title }}</div>
      </a>
    {% endfor %}
  </div>
</section>

<style>
  .fcc-wrap{max-width:1600px;margin:0 auto;padding:140px 5vw;}
  .fcc-heading{font-size:clamp(32px,4.5vw,56px);font-weight:700;color:var(--lc-text,#171717);margin:0 0 56px;letter-spacing:-1px;text-align:center;}
  .fcc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:28px;}
  .fcc-tile{position:relative;display:block;aspect-ratio:4/5;border-radius:12px;overflow:hidden;
    background:#fff;text-decoration:none;box-shadow:0 1px 3px rgba(0,0,0,.06);}
  .fcc-img{width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.16,1,.3,1);}
  .fcc-tile:hover .fcc-img{transform:scale(1.045);}
  .fcc-tile::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0) 55%,rgba(0,0,0,.45) 100%);}
  .fcc-label{position:absolute;left:28px;bottom:28px;z-index:1;color:#fff;font-size:20px;font-weight:600;letter-spacing:-0.2px;}
</style>

{% schema %}
{
  "name": "Featured collections",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" } ],
  "blocks": [
    { "type": "tile", "name": "Category tile", "settings": [ { "type": "collection", "id": "collection", "label": "Collection" }, { "type": "image_picker", "id": "image", "label": "Tile image (optional override)" }, { "type": "text", "id": "label", "label": "Label override" } ] }
  ],
  "presets": [ { "name": "Featured collections", "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ] } ]
}
{% endschema %}
