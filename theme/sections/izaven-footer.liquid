{%- comment -%}
  Section contract.
  IZAVEN footer, built from HTML, CSS and the uploaded PNG logo. It carries the
  showroom's atmosphere (black marble, silver rules, warm LED edge) without
  ever using the studio photograph as a background.

  Every link only renders when its destination exists (a page, a non-empty
  collection or a store policy). Social links only render when a URL is set.
  The newsletter posts to Shopify's own customer form, so sign-ups land in
  Customers with email marketing consent.
  @example Placed in sections/footer-group.json
{%- endcomment -%}

{%- liquid
  assign shop_categories = 'hoodies,t-shirts,tracksuits,accessories,new-arrivals,men-tops-shirts,bottoms,sneakers-shoes' | split: ','
  assign s = section.settings
  assign instagram = s.instagram | default: settings.social_instagram_link
  assign tiktok = s.tiktok | default: settings.social_tiktok_link
  assign youtube = s.youtube | default: settings.social_youtube_link
  assign facebook = s.facebook | default: settings.social_facebook_link
  assign x_link = s.x_twitter | default: settings.social_twitter_link
  assign pinterest = s.pinterest | default: settings.social_pinterest_link
  assign has_social = false
  if instagram != blank or tiktok != blank or youtube != blank or facebook != blank or x_link != blank or pinterest != blank
    assign has_social = true
  endif
-%}

<div class="izf" data-izf>
  <div class="izf__edge" aria-hidden="true"></div>

  <div class="izf__wrap">
    <div class="izf__brand">
      <a class="izf__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
        <img
          src="{{ 'izaven-logo.png' | asset_url }}"
          alt="{{ shop.name | escape }}"
          width="1536"
          height="1024"
          loading="lazy"
          decoding="async"
        >
      </a>
      {%- if s.statement != blank -%}
        <p class="izf__statement">{{ s.statement | escape }}</p>
      {%- endif -%}
      <span class="izf__rule" aria-hidden="true"></span>
    </div>

    <nav class="izf__col" aria-label="Shop">
      <details class="izf__acc" open>
        <summary><h2>Shop</h2></summary>
        <ul>
          {%- if s.shop_menu != blank and s.shop_menu.links.size > 0 -%}
            {%- for link in s.shop_menu.links -%}
              <li><a class="izf__link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a class="izf__link" href="{{ routes.all_products_collection_url }}">All Products</a></li>
            {%- for h in shop_categories -%}
              {%- assign c = collections[h] -%}
              {%- if c.url != blank and c.products_count > 0 -%}
                <li><a class="izf__link" href="{{ c.url }}">{{ c.title | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </details>
    </nav>

    <nav class="izf__col" aria-label="Brand">
      <details class="izf__acc" open>
        <summary><h2>Brand</h2></summary>
        <ul>
          {%- if s.brand_menu != blank and s.brand_menu.links.size > 0 -%}
            {%- for link in s.brand_menu.links -%}
              <li><a class="izf__link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {%- render 'izaven-footer-link', label: 'About IZAVEN', page_handles: 'about,about-us,about-izaven' -%}
            {%- render 'izaven-footer-link', label: 'Our Story', page_handles: 'our-story,story' -%}
            {%- render 'izaven-footer-link', label: 'Lookbook', page_handles: 'lookbook' -%}
            {%- render 'izaven-footer-link', label: 'Size Guide', page_handles: 'size-guide,sizing,size-chart' -%}
            {%- render 'izaven-footer-link', label: 'Care Instructions', page_handles: 'care-instructions,care,care-guide' -%}
            {%- render 'izaven-footer-link', label: 'Contact', page_handles: 'contact,contact-us' -%}
          {%- endif -%}
        </ul>
      </details>
    </nav>

    <nav class="izf__col" aria-label="Help">
      <details class="izf__acc" open>
        <summary><h2>Help</h2></summary>
        <ul>
          {%- if s.help_menu != blank and s.help_menu.links.size > 0 -%}
            {%- for link in s.help_menu.links -%}
              <li><a class="izf__link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {%- render 'izaven-footer-link', label: 'FAQ', page_handles: 'faq,faqs' -%}
            {%- render 'izaven-footer-link', label: 'Shipping', page_handles: 'shipping,shipping-policy', url: shop.shipping_policy.url -%}
            {%- render 'izaven-footer-link', label: 'Returns & Refunds', page_handles: 'returns,refund-policy', url: shop.refund_policy.url -%}
            {%- render 'izaven-footer-link', label: 'Track Your Order', page_handles: 'track-your-order,order-tracking,tracking,track-order' -%}
            {%- render 'izaven-footer-link', label: 'Terms of Service', url: shop.terms_of_service.url -%}
            {%- render 'izaven-footer-link', label: 'Privacy Policy', url: shop.privacy_policy.url -%}
          {%- endif -%}
        </ul>
      </details>
    </nav>

    <div class="izf__col izf__connect">
      <h2 class="izf__h">Connect</h2>
      {%- if s.newsletter_text != blank -%}
        <p class="izf__lede">{{ s.newsletter_text | escape }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'izf-newsletter', class: 'izf__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="izf__sr" for="izf-email-{{ section.id }}">Email address</label>
        <div class="izf__field">
          <input
            id="izf-email-{{ section.id }}"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            autocomplete="email"
            placeholder="Email address"
            required
            {% if form.errors %}aria-invalid="true" aria-describedby="izf-msg-{{ section.id }}"{% endif %}
          >
          <button type="submit">{{ s.newsletter_button | default: 'Subscribe' | escape }}</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="izf__msg izf__msg--ok" id="izf-msg-{{ section.id }}" role="status">Thank you. You are on the list.</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="izf__msg izf__msg--err" id="izf-msg-{{ section.id }}" role="alert">{{ form.errors.messages['email'] | default: 'Enter a valid email address.' }}</p>
        {%- endif -%}
      {%- endform -%}

      {%- if has_social -%}
        <ul class="izf__social" aria-label="Social media">
          {%- if instagram != blank -%}<li><a class="izf__link" href="{{ instagram }}" target="_blank" rel="noopener me">Instagram</a></li>{%- endif -%}
          {%- if tiktok != blank -%}<li><a class="izf__link" href="{{ tiktok }}" target="_blank" rel="noopener me">TikTok</a></li>{%- endif -%}
          {%- if youtube != blank -%}<li><a class="izf__link" href="{{ youtube }}" target="_blank" rel="noopener me">YouTube</a></li>{%- endif -%}
          {%- if facebook != blank -%}<li><a class="izf__link" href="{{ facebook }}" target="_blank" rel="noopener me">Facebook</a></li>{%- endif -%}
          {%- if x_link != blank -%}<li><a class="izf__link" href="{{ x_link }}" target="_blank" rel="noopener me">X</a></li>{%- endif -%}
          {%- if pinterest != blank -%}<li><a class="izf__link" href="{{ pinterest }}" target="_blank" rel="noopener me">Pinterest</a></li>{%- endif -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

  <div class="izf__bar">
    <p class="izf__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. All rights reserved.</p>
    <ul class="izf__legal">
      {%- if shop.terms_of_service.url != blank -%}<li><a class="izf__link" href="{{ shop.terms_of_service.url }}">Terms</a></li>{%- endif -%}
      {%- if shop.privacy_policy.url != blank -%}<li><a class="izf__link" href="{{ shop.privacy_policy.url }}">Privacy</a></li>{%- endif -%}
      {%- if shop.refund_policy.url != blank -%}<li><a class="izf__link" href="{{ shop.refund_policy.url }}">Refunds</a></li>{%- endif -%}
      {%- if shop.shipping_policy.url != blank -%}<li><a class="izf__link" href="{{ shop.shipping_policy.url }}">Shipping</a></li>{%- endif -%}
    </ul>
    {%- if s.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="izf__pay" aria-label="Accepted payment methods">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'izf__pay-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'izaven-footer.js' | asset_url }}" defer></script>

{% stylesheet %}
  .izf {
    --izf-bg: #060607;
    --izf-surface: #0d0d10;
    --izf-line: rgb(255 255 255 / 0.1);
    --izf-silver: #c9ccd2;
    --izf-text: #e9e9ec;
    --izf-muted: #8a8c93;
    --izf-warm: #ffeed6;
    --izf-ease: cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(120% 80% at 50% -10%, #15151a 0%, rgb(21 21 26 / 0) 60%),
      linear-gradient(180deg, #08080a 0%, var(--izf-bg) 100%);
    color: var(--izf-text);
    font-family: var(--font-body--family, system-ui, sans-serif);
    -webkit-font-smoothing: antialiased;
  }

  /* Black-marble veining: one static, very low-contrast layer of contour lines. Delete this block and the footer is still complete. */
  .izf::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.085;
    pointer-events: none;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 140px);
    mask-image: linear-gradient(to bottom, transparent 0, #000 140px);
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1600' height='700'><filter id='m' x='0' y='0' width='100%' height='100%' color-interpolation-filters='sRGB'><feTurbulence type='fractalNoise' baseFrequency='0.0032 0.0075' numOctaves='4' seed='7' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.92 0 0 0 0 0.92 0 0 0 0 0.94 1 0 0 0 0'/><feComponentTransfer><feFuncA type='table' tableValues='0 0 0 0 0 0 0 0.25 1 0.25 0 0 0 0 0 0 0'/></feComponentTransfer></filter><rect width='1600' height='700' filter='url(%23m)'/></svg>");
  }

  /* Warm LED edge: echoes the showroom's illuminated architecture and meets the studio's fade-out. */
  .izf__edge {
    position: relative;
    height: 1px;
    background: linear-gradient(90deg, rgb(255 238 214 / 0), rgb(255 238 214 / 0.85) 50%, rgb(255 238 214 / 0));
    box-shadow: 0 0 26px 1px rgb(255 238 214 / 0.28);
  }
  .izf__edge::after {
    content: '';
    position: absolute;
    inset: 1px 0 auto;
    height: 90px;
    background: linear-gradient(to bottom, rgb(255 238 214 / 0.045), rgb(255 238 214 / 0));
    pointer-events: none;
  }

  .izf__wrap {
    max-width: 1400px;
    margin: 0 auto;
    padding: clamp(48px, 7vw, 96px) max(20px, env(safe-area-inset-right)) clamp(36px, 5vw, 64px) max(20px, env(safe-area-inset-left));
    display: grid;
    grid-template-columns: 1.25fr repeat(3, minmax(0, 1fr)) 1.35fr;
    gap: clamp(28px, 3.5vw, 56px);
  }

  .izf__brand { display: grid; align-content: start; gap: 18px; justify-items: start; }
  .izf__logo { display: block; width: clamp(150px, 15vw, 210px); }
  .izf__logo img { display: block; width: 100%; height: auto; object-fit: contain; filter: invert(1) brightness(0.96); }
  .izf__logo:focus-visible { outline: 2px solid var(--izf-warm); outline-offset: 4px; }
  .izf__statement { margin: 0; font-size: 11px; font-weight: 600; letter-spacing: 0.34em; text-transform: uppercase; color: var(--izf-silver); }
  .izf__rule { width: 72px; height: 1px; background: linear-gradient(90deg, var(--izf-warm), rgb(255 238 214 / 0)); }

  .izf__col { min-width: 0; }
  .izf__col h2, .izf__h {
    margin: 0 0 20px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--izf-silver);
  }
  .izf__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .izf__acc summary { list-style: none; cursor: default; }
  .izf__acc summary::-webkit-details-marker { display: none; }

  .izf__link {
    position: relative;
    display: inline-block;
    padding: 6px 0;
    color: var(--izf-muted);
    font-size: 14px;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: color 0.3s var(--izf-ease);
  }
  .izf__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 3px;
    height: 1px;
    background: var(--izf-warm);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--izf-ease);
  }
  .izf__link:hover { color: var(--izf-warm); }
  .izf__link:hover::after { transform: scaleX(1); }
  .izf__link:focus-visible { outline: 2px solid var(--izf-warm); outline-offset: 3px; color: var(--izf-warm); }

  .izf__lede { margin: 0 0 16px; max-width: 34ch; color: var(--izf-muted); font-size: 14px; line-height: 1.55; }
  .izf__sr { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .izf__field { display: flex; border: 1px solid var(--izf-line); background: rgb(255 255 255 / 0.02); transition: border-color 0.3s; }
  .izf__field:focus-within { border-color: rgb(255 238 214 / 0.6); }
  .izf__field input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    padding: 0 14px;
    border: 0;
    background: transparent;
    color: var(--izf-text);
    font: inherit;
    font-size: 14px;
  }
  .izf__field input::placeholder { color: #6f7178; }
  .izf__field input:focus { outline: none; }
  .izf__field button {
    min-height: 48px;
    padding: 0 18px;
    border: 0;
    border-left: 1px solid var(--izf-line);
    background: transparent;
    color: var(--izf-warm);
    font: inherit;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s;
  }
  .izf__field button:hover { background: rgb(255 238 214 / 0.1); }
  .izf__field button:focus-visible { outline: 2px solid var(--izf-warm); outline-offset: -3px; }
  .izf__msg { margin: 10px 0 0; font-size: 13px; }
  .izf__msg--ok { color: var(--izf-warm); }
  .izf__msg--err { color: #f0a090; }
  .izf__social { margin-top: 18px !important; display: flex !important; flex-wrap: wrap; gap: 4px 20px !important; }

  .izf__bar {
    max-width: 1400px;
    margin: 0 auto;
    padding: 22px max(20px, env(safe-area-inset-right)) calc(26px + env(safe-area-inset-bottom)) max(20px, env(safe-area-inset-left));
    border-top: 1px solid var(--izf-line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 28px;
  }
  .izf__copy { margin: 0; color: var(--izf-muted); font-size: 12px; letter-spacing: 0.04em; }
  .izf__legal { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 22px; }
  .izf__legal .izf__link { font-size: 12px; }
  .izf__pay { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .izf__pay-icon { display: block; height: 22px; width: auto; }

  /* Entrance: JS adds .izf-js, so with no JS everything is simply visible. */
  .izf-js .izf__edge { transform: scaleX(0); transition: transform 1.5s var(--izf-ease); }
  .izf-js.is-in .izf__edge { transform: scaleX(1); }
  .izf-js .izf__logo, .izf-js .izf__statement { opacity: 0; translate: 0 10px; transition: opacity 1.1s var(--izf-ease) 0.25s, translate 1.1s var(--izf-ease) 0.25s; }
  .izf-js.is-in .izf__logo, .izf-js.is-in .izf__statement { opacity: 1; translate: 0 0; }

  @media (max-width: 1100px) {
    .izf__wrap { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .izf__brand { grid-column: 1 / -1; }
    .izf__connect { grid-column: 1 / -1; max-width: 520px; }
  }

  @media (max-width: 749px) {
    .izf__wrap { grid-template-columns: 1fr; gap: 0; padding-top: 44px; }
    .izf__brand { justify-items: center; text-align: center; padding-bottom: 32px; }
    .izf__logo { width: 150px; }
    .izf__rule { background: linear-gradient(90deg, rgb(255 238 214 / 0), var(--izf-warm), rgb(255 238 214 / 0)); }

    .izf__col:not(.izf__connect) { border-top: 1px solid var(--izf-line); }
    .izf__acc summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 56px;
      cursor: pointer;
    }
    .izf__acc summary h2 { margin: 0; }
    .izf__acc summary::after { content: '+'; font-size: 20px; font-weight: 300; color: var(--izf-silver); transition: rotate 0.3s var(--izf-ease); }
    .izf__acc[open] summary::after { rotate: 45deg; }
    .izf__acc summary:focus-visible { outline: 2px solid var(--izf-warm); outline-offset: -2px; }
    .izf__acc ul { padding-bottom: 14px; }
    .izf__link { padding: 11px 0; font-size: 15px; }
    .izf__connect { border-top: 1px solid var(--izf-line); padding-top: 32px; }
    .izf__bar { flex-direction: column; align-items: flex-start; }
    .izf__legal .izf__link { padding: 9px 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .izf *, .izf *::before, .izf *::after { transition: none !important; }
    .izf-js .izf__edge { transform: none; }
    .izf-js .izf__logo, .izf-js .izf__statement { opacity: 1; translate: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "IZAVEN footer",
  "class": "section-wrapper",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "text", "id": "statement", "label": "Brand statement", "default": "More than clothing." },

    { "type": "header", "content": "Link columns" },
    { "type": "paragraph", "content": "By default each column lists only the pages, collections and store policies that exist. Choose a menu to take full control of a column instead." },
    { "type": "link_list", "id": "shop_menu", "label": "Shop menu" },
    { "type": "link_list", "id": "brand_menu", "label": "Brand menu" },
    { "type": "link_list", "id": "help_menu", "label": "Help menu" },

    { "type": "header", "content": "Connect" },
    { "type": "text", "id": "newsletter_text", "label": "Invitation", "default": "Join the community for first access to drops and restocks." },
    { "type": "text", "id": "newsletter_button", "label": "Button label", "default": "Subscribe" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "url", "id": "youtube", "label": "YouTube" },
    { "type": "url", "id": "facebook", "label": "Facebook" },
    { "type": "url", "id": "x_twitter", "label": "X" },
    { "type": "url", "id": "pinterest", "label": "Pinterest" },

    { "type": "header", "content": "Bottom bar" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show accepted payment methods", "default": true }
  ],
  "presets": [
    { "name": "IZAVEN footer", "category": "Footer" }
  ]
}
{% endschema %}
