{% comment %}
  Collection page, light palette: banner, sort dropdown, responsive grid,
  pagination, empty state.
{% endcomment %}
<section class="clg-wrap">
  <div class="clg-banner">
    {% if collection.image %}
      {{ collection.image | image_url: width: 1800 | image_tag: loading: 'eager', class: 'clg-banner-img' }}
    {% endif %}
    <div class="clg-banner-text">
      <h1>{{ collection.title }}</h1>
      {% if collection.description != blank %}<p>{{ collection.description | strip_html | truncate: 160 }}</p>{% endif %}
    </div>
  </div>

  <div class="clg-toolbar">
    <span class="clg-count">{{ collection.products_count }} products</span>
    {% form 'sort-by-form' %}
      <select name="sort_by" class="clg-sort" onchange="this.form.submit()">
        {% for option in collection.sort_options %}
          <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
        {% endfor %}
      </select>
    {% endform %}
  </div>

  {% paginate collection.products by 24 %}
    {% if collection.products.size == 0 %}
      <div class="clg-empty">
        <p>No products found in this collection yet.</p>
        <a href="/collections/all" class="clg-empty-link">Browse all products →</a>
      </div>
    {% else %}
      <div class="clg-grid">
        {% for product in collection.products %}
          <a href="{{ product.url }}" class="clg-card">
            <div class="clg-card-media">
              {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'clg-card-img clg-card-img--primary' }}
              {% if product.media.size > 1 %}
                {{ product.media[1] | image_url: width: 700 | image_tag: loading: 'lazy', class: 'clg-card-img clg-card-img--hover' }}
              {% endif %}
              {% unless product.available %}<span class="clg-badge">Sold out</span>{% endunless %}
            </div>
            <div class="clg-card-title">{{ product.title }}</div>
            <div class="clg-card-price">
              {% if product.compare_at_price > product.price %}
                <span class="clg-sale">{{ product.price | money }}</span>
                <span class="clg-compare">{{ product.compare_at_price | money }}</span>
              {% else %}
                {{ product.price | money }}
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div class="clg-pagination">
          {% if paginate.previous %}<a href="{{ paginate.previous.url }}" class="clg-page-link">← Prev</a>{% endif %}
          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="clg-page-link">{{ part.title }}</a>
            {% else %}
              <span class="clg-page-current">{{ part.title }}</span>
            {% endif %}
          {% endfor %}
          {% if paginate.next %}<a href="{{ paginate.next.url }}" class="clg-page-link">Next →</a>{% endif %}
        </div>
      {% endif %}
    {% endif %}
  {% endpaginate %}
</section>

<style>
  .clg-wrap{max-width:1440px;margin:0 auto;padding:0 5vw 80px;}
  .clg-banner{position:relative;border-radius:6px;overflow:hidden;min-height:200px;margin-bottom:28px;background:#fff;border:1px solid var(--lc-border,#DADADA);display:flex;align-items:center;}
  .clg-banner-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.9;}
  .clg-banner-text{position:relative;z-index:1;padding:36px;background:rgba(255,255,255,.55);backdrop-filter:blur(6px);}
  .clg-banner-text h1{margin:0 0 8px;font-size:clamp(24px,3vw,38px);color:var(--lc-text,#171717);font-weight:600;}
  .clg-banner-text p{margin:0;color:var(--lc-text-soft,#777);max-width:560px;}
  .clg-toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;color:var(--lc-text-soft,#777);font-size:13px;}
  .clg-sort{background:#fff;border:1px solid var(--lc-border,#DADADA);color:var(--lc-text,#171717);padding:8px 10px;border-radius:3px;}
  .clg-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px 16px;}
  .clg-card{text-decoration:none;display:block;}
  .clg-card-media{position:relative;border-radius:5px;overflow:hidden;background:#fff;border:1px solid var(--lc-border,#DADADA);aspect-ratio:3/4;}
  .clg-card-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  .clg-card-img--hover{opacity:0;transition:opacity .3s ease;}
  .clg-card:hover .clg-card-img--hover{opacity:1;}
  .clg-badge{position:absolute;top:10px;left:10px;background:rgba(23,23,23,.8);color:#fff;font-size:11px;
    padding:4px 8px;border-radius:3px;letter-spacing:.5px;text-transform:uppercase;}
  .clg-card-title{margin-top:10px;color:var(--lc-text,#171717);font-size:14px;}
  .clg-card-price{color:var(--lc-text-soft,#777);font-size:13px;margin-top:2px;}
  .clg-sale{color:var(--lc-text,#171717);font-weight:700;}
  .clg-compare{text-decoration:line-through;margin-left:6px;}
  .clg-empty{text-align:center;padding:80px 0;color:var(--lc-text-soft,#777);}
  .clg-empty-link{color:var(--lc-text,#171717);font-weight:600;text-decoration:none;}
  .clg-pagination{display:flex;justify-content:center;gap:10px;margin-top:40px;color:var(--lc-text-soft,#777);font-size:13px;}
  .clg-page-link{color:var(--lc-text-soft,#777);text-decoration:none;}
  .clg-page-current{color:var(--lc-text,#171717);font-weight:700;}
  @media (max-width:749px){ .clg-grid{grid-template-columns:repeat(2,1fr);} }
</style>

{% schema %}
{ "name": "Collection grid", "settings": [] }
{% endschema %}
