{%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
{%- assign logo = section.settings.logo | default: shop.brand.logo -%}

<div class="cg" id="cg">
  <canvas class="cg-amb" id="cg-amb" aria-hidden="true"></canvas>

  <header class="cg-nav">
    <a class="cg-nav__brand" href="{{ routes.root_url }}" aria-label="{{ section.settings.brand_name | default: 'ClothingNow' | escape }} home">
      {%- if logo -%}
        <img class="cg-nav__logo" src="{{ logo | image_url: height: 72 }}" alt="" width="{{ logo.width | times: 36 | divided_by: logo.height | at_most: 160 }}" height="36" decoding="async">
      {%- endif -%}
      <span class="cg-nav__name">{{ section.settings.brand_name | default: 'ClothingNow' }}</span>
    </a>
    <nav class="cg-nav__links" aria-label="Primary">
      <a href="{{ routes.root_url }}">Home</a>
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
    </nav>
    <a class="cg-nav__bag" href="{{ routes.cart_url }}" aria-label="Bag, {{ cart.item_count }} items">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
      {%- if cart.item_count > 0 -%}<span class="cg-nav__count">{{ cart.item_count }}</span>{%- endif -%}
    </a>
  </header>

  {%- if section.settings.banner_video != blank or section.settings.banner_image != blank -%}
  <div class="cg-banner">
    {%- if section.settings.banner_video != blank -%}
      {{ section.settings.banner_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'cg-banner__media', image_size: '1600x' }}
    {%- else -%}
      {{ section.settings.banner_image | image_url: width: 2200 | image_tag: loading: 'eager', class: 'cg-banner__media' }}
    {%- endif -%}
    <div class="cg-banner__fade"></div>
  </div>
  {%- endif -%}
  <div class="cg-head">
    <p class="cg-eyebrow">Collection</p>
    <h1 class="cg-title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p class="cg-desc">{{ collection.description | strip_html | truncatewords: 34 }}</p>
    {%- endif -%}
  </div>

  <div class="cg-bar">
    <span class="cg-count">{{ collection.products_count }} {% if collection.products_count == 1 %}style{% else %}styles{% endif %}</span>
    <div class="cg-sort">
      <label for="cg-sort-sel">Sort by</label>
      <select id="cg-sort-sel">
        {%- for opt in collection.sort_options -%}
          <option value="{{ opt.value }}"{% if opt.value == sort_by %} selected{% endif %}>{{ opt.name }}</option>
        {%- endfor -%}
      </select>
    </div>
  </div>

  <main class="cg-main">
    {%- paginate collection.products by section.settings.per_page -%}
      <div class="cg-grid">
        {%- for p in collection.products -%}
          {% render 'cn-product-card', p: p %}
        {%- else -%}
          <p class="cg-empty">No styles found yet. Check back soon.</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="cg-pages" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr; Prev</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}<span class="on" aria-current="page">{{ part.title }}</span>
            {%- else -%}<span class="gap">&hellip;</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next &rarr;</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </main>
</div>

<style>
:root { --cg-ink: #1e1a16; --cg-muted: #5f5240; --cg-cream: #f5f0e8; --cg-parch: #ede5d8; --cg-line: rgba(120, 100, 70, 0.24); }
body:has(.cg) { background: var(--cg-cream); }
body:has(.cg) .page-wrapper, body:has(.cg) #MainContent { background: transparent; }
.cg { position: relative; min-height: 100vh; color: var(--cg-ink); font-family: var(--font-body--family, 'Inter'), -apple-system, 'Segoe UI', Roboto, sans-serif; }
.cg *, .cg *::before, .cg *::after { box-sizing: border-box; }
.cg-amb { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; opacity: 0; transition: opacity 1.2s ease; }
.cg > *:not(.cg-amb) { position: relative; z-index: 1; }
.cg > .cg-nav { position: fixed; z-index: 1000; }

.cg-nav { position: fixed; top: 12px; left: 50%; transform: translateX(-50%); z-index: 1000; display: flex; align-items: center; gap: clamp(14px, 3vw, 28px); width: max-content; max-width: calc(100vw - 24px); height: 56px; padding: 0 10px 0 22px; border-radius: 999px; background: linear-gradient(160deg, rgba(255, 255, 255, 0.74) 0%, rgba(255, 255, 255, 0.4) 45%, rgba(232, 221, 208, 0.46) 80%, rgba(200, 184, 154, 0.55) 100%); -webkit-backdrop-filter: blur(28px) saturate(1.9); backdrop-filter: blur(28px) saturate(1.9); border: 1px solid rgba(255, 255, 255, 0.82); box-shadow: 0 14px 44px rgba(120, 100, 70, 0.26), 0 1px 0 rgba(255, 255, 255, 0.95) inset; }
.cg-nav a { color: var(--cg-ink); text-decoration: none; }
.cg-nav__brand { display: inline-flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 800; letter-spacing: 0.32em; text-transform: uppercase; white-space: nowrap; }
.cg-nav__logo { width: auto; height: 36px; max-width: 160px; object-fit: contain; border-radius: 6px; }
.cg-nav__links { display: flex; gap: clamp(12px, 2.5vw, 24px); }
.cg-nav__links a { font-size: 11px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; padding: 8px 2px; border-bottom: 1px solid transparent; }
.cg-nav__links a:hover { border-bottom-color: var(--cg-ink); }
.cg-nav__bag { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; }
.cg-nav__bag:hover { background: rgba(255, 255, 255, 0.55); }
.cg-nav__count { position: absolute; top: 3px; right: 0; min-width: 18px; height: 18px; padding: 0 5px; display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; background: var(--cg-ink); color: var(--cg-cream); font-size: 10px; font-weight: 800; }

.cg-banner { position: relative; width: 100%; height: clamp(260px, 52vh, 560px); overflow: hidden; margin-bottom: -150px; }
.cg-banner__media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.cg-banner__fade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(245,240,232,0) 35%, rgba(245,240,232,.75) 75%, #f5f0e8 100%); }
.cg-banner + .cg-head { position: relative; z-index: 2; padding-top: 0; }
.cg-head { padding: 120px clamp(16px, 4vw, 44px) 28px; max-width: 1340px; margin: 0 auto; text-align: center; }
.cg-eyebrow { margin: 0 0 8px; font-size: 12px; font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase; color: var(--cg-muted); }
.cg-title { margin: 0; font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif; font-size: clamp(38px, 6vw, 72px); font-weight: 500; line-height: 1.02; letter-spacing: -0.005em; color: var(--cg-ink); text-transform: none; }
.cg-desc { margin: 16px auto 0; max-width: 620px; font-size: 16px; line-height: 1.7; font-weight: 500; color: var(--cg-ink); }

.cg-bar { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 16px; max-width: 1340px; margin: 12px auto 0; padding: 12px clamp(16px, 4vw, 44px); border-bottom: 1px solid var(--cg-line); }
.cg-bar::before { content: ''; position: absolute; inset: 0 -100vw; z-index: -1; background: rgba(245, 240, 232, 0.82); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); }
.cg-count { font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--cg-ink); }
.cg-sort { display: flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
.cg-sort select { min-height: 44px; padding: 8px 14px; border-radius: 10px; border: 1.5px solid var(--cg-line); background: rgba(255, 255, 255, 0.65); color: var(--cg-ink); font: 600 13px/1 inherit; font-family: inherit; cursor: pointer; }
.cg-sort select:focus-visible, .cg-pages a:focus-visible { outline: 2px solid var(--cg-ink); outline-offset: 3px; }

.cg-main { max-width: 1340px; margin: 0 auto; padding: 28px clamp(16px, 4vw, 44px) 96px; }
.cg-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
.cg-empty { grid-column: 1 / -1; padding: 64px 0; text-align: center; font-size: 15px; font-weight: 600; color: var(--cg-muted); }
.cg-pages { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 52px; }
.cg-pages a, .cg-pages span { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; padding: 0 16px; border-radius: 10px; border: 1.5px solid var(--cg-line); background: rgba(255, 255, 255, 0.55); color: var(--cg-ink); font-size: 13px; font-weight: 700; text-decoration: none; }
.cg-pages a:hover { border-color: var(--cg-ink); }
.cg-pages .on { background: var(--cg-ink); border-color: var(--cg-ink); color: var(--cg-cream); }
.cg-pages .gap { border-color: transparent; background: none; }

@media (max-width: 1100px) { .cg-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (max-width: 760px) { .cg-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } .cg-head { padding-top: 104px; } .cg-banner + .cg-head { padding-top: 0; } }
@media (max-width: 520px) {
  .cg-nav { padding-left: 16px; gap: 12px; }
  .cg-nav__brand { letter-spacing: 0.22em; font-size: 11px; }
  .cg-nav__logo + .cg-nav__name { display: none; }
  .cg-nav__links a:first-child { display: none; }
  .cg-sort label { display: none; }
}
</style>

<script src="{{ 'cn-ambient.js' | asset_url }}" defer></script>
<script>
(function () {
  'use strict';
  var sel = document.getElementById('cg-sort-sel');
  if (sel) sel.addEventListener('change', function () {
    var u = new URL(window.location.href);
    u.searchParams.set('sort_by', sel.value);
    u.searchParams.delete('page');
    window.location.href = u.toString();
  });
  function start() {
    if (!window.CNAmbient) return;
    var amb = window.CNAmbient.create(document.getElementById('cg-amb'), { opacity: 0.38 });
    if (!amb) return;
    var imgs = document.querySelectorAll('.cn-card__img');
    var i = 0;
    function next() {
      if (!imgs.length) { amb.neutral(); return; }
      var im = imgs[i % imgs.length];
      if (im.complete && im.naturalWidth > 0 && amb.fromSource(im)) return;
      amb.neutral();
    }
    next();
    var cards = document.querySelectorAll('.cn-card');
    for (var k = 0; k < cards.length; k++) {
      cards[k].addEventListener('mouseenter', (function (c) { return function () {
        var im = c.querySelector('.cn-card__img');
        if (im && im.complete && im.naturalWidth > 0) amb.fromSource(im);
      }; })(cards[k]));
    }
  }
  if (document.readyState === 'complete') start();
  else window.addEventListener('load', start);
})();
</script>

{% schema %}
{
  "name": "Collection page (glass)",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo in the top pill (uses your store logo if empty)" },
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "ClothingNow" },
    { "type": "video", "id": "banner_video", "label": "Top banner video (fades into the page)" },
    { "type": "image_picker", "id": "banner_image", "label": "Banner image (used if no video)" },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16 }
  ],
  "presets": [{ "name": "Collection page (glass)" }]
}
{% endschema %}
