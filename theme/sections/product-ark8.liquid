      var rm = mk('button', 'ark-ci__rm', 'Remove'); rm.type = 'button';
      rm.addEventListener('click', function () { change(i + 1, 0); });
      li.appendChild(a); li.appendChild(mid); li.appendChild(rm); list.appendChild(li);
