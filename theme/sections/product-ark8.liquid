{% schema %}
{
  "name": "Product canvas",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Floating-panel product canvas. The main image comes from the product metafield custom.cutout_image (transparent PNG/WebP) or the product's first image; thumbnails are the product's media." },
    { "type": "text", "id": "brand_name", "label": "Brand wordmark", "default": "IZAVEN" },
    { "type": "link_list", "id": "menu", "label": "Centre navigation (first 3 links)", "default": "main-menu" },
    { "type": "color", "id": "canvas", "label": "Canvas colour", "default": "#E9E6E1" },
    { "type": "checkbox", "id": "show_save", "label": "Show Save button (stores on this device)", "default": true },
    { "type": "checkbox", "id": "blend_white", "label": "Blend a white photo background into the canvas", "info": "Off by default. Multiplies the image against the canvas, which lightens nothing but turns pure white into the canvas colour and slightly shifts light tones. Leave off for transparent PNGs.", "default": false },
    { "type": "page", "id": "size_guide_page", "label": "Size guide page" },
    { "type": "richtext", "id": "shipping_text", "label": "Shipping & returns text", "default": "<p>Made to order. Estimated delivery 5–10 days.</p>" },
    { "type": "header", "content": "Studio background" },
    { "type": "checkbox", "id": "show_studio", "label": "Show studio background", "default": true },
    { "type": "image_picker", "id": "studio_image", "label": "Studio background image", "info": "Leave empty to use the bundled IZAVEN studio image. For 4K sharpness upload an image at least 3840 px wide." },
    { "type": "video", "id": "studio_video", "label": "Studio background video (optional)", "info": "Plays muted and looped behind the whole page, over the image. Upload a short, compressed MP4 (under ~10 MB). Leave empty for the image only." },
    { "type": "image_picker", "id": "logo", "label": "Logo in the top pill (uses the store logo if empty)" },
    { "type": "range", "id": "studio_opacity", "label": "Studio image strength", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Bottom dock (delivery, offer, store links)" },
    { "type": "link_list", "id": "dock_menu", "label": "Store links in the dock", "default": "footer" },
    { "type": "range", "id": "delivery_min", "label": "Delivery: earliest (days)", "min": 1, "max": 60, "step": 1, "default": 5 },
    { "type": "range", "id": "delivery_max", "label": "Delivery: latest (days)", "min": 1, "max": 60, "step": 1, "default": 10 },
    { "type": "text", "id": "tracking_path", "label": "Order tracking link", "default": "/pages/track-your-order" },
    { "type": "header", "content": "Bag: second-piece offer" },
    { "type": "text", "id": "bundle_collection", "label": "Collection handle for suggestions", "default": "bundle-eligible" },
    { "type": "range", "id": "bundle_percent", "label": "Discount shown (%)", "info": "Display only. Keep equal to the Shopify automatic discount.", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 30 },
    { "type": "header", "content": "Connector lines (position on the image, %)" },
    { "type": "range", "id": "left_x", "label": "Left line: x", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 2 },
    { "type": "range", "id": "left_y", "label": "Left line: y", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 29 },
    { "type": "range", "id": "right_x", "label": "Right line: x", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 98 },
    { "type": "range", "id": "right_y", "label": "Right line: y", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 48 }
  ],
  "presets": [{ "name": "Product canvas" }]
}
{% endschema %}
