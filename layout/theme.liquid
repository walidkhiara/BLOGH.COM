<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_text }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'izaven-mark.png' | asset_url }}">
    {%- endif -%}
    <link rel="apple-touch-icon" href="{{ 'izaven-mark.png' | asset_url }}">

    <title>
      {{ page_title | escape }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' | escape }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- assign meta_description = page_description | default: settings.seo_home_description -%}
    {%- if meta_description != blank -%}
      <meta name="description" content="{{ meta_description | strip_html | strip_newlines | escape | truncate: 300 }}">
    {%- endif -%}
    {%- if template.name == 'search' or template.name == 'cart' or template.directory == 'customers' or template.suffix == 'noindex' -%}
      <meta name="robots" content="noindex, follow">
    {%- endif -%}

    {% render 'meta-tags' %}
    {% render 'structured-data' %}
    {% render 'theme-styles' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if settings.reveal_on_scroll %} reveal-on{% endif %}">
    {%- if settings.intro_enabled and request.design_mode == false and template.name == 'index' -%}{% render 'logo-intro' %}{%- endif -%}
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}
    {% render 'search-modal' %}

    <script>
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          inStock: {{ 'products.product.in_stock' | t | json }},
          cartError: {{ 'cart.error' | t | json }}
        }
      };
    </script>
  </body>
</html>
